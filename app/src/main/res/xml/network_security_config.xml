<?xml version="1.0" encoding="utf-8"?>
<!-- Le serveur Lumière est joint en HTTP en clair (choix de l'utilisateur) ; HTTPS reste possible. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
